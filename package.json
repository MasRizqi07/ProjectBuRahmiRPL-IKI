{
  "name": "war-ticket-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "playwright test",
    "merchant:configure": "pnpm --filter @war-ticket/worker merchant:configure",
    "loadtest:provision": "pnpm --filter @war-ticket/web loadtest:provision",
    "loadtest:teardown": "pnpm --filter @war-ticket/web loadtest:teardown",
    "db:migrate": "pnpm --filter @war-ticket/web db:migrate",
    "fixture:seed": "pnpm --filter @war-ticket/web fixture:seed",
    "gates:verify": "pnpm --filter @war-ticket/web gates:verify",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.52.0"
  }
}
