# Shared infrastructure
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/war_ticket
REDIS_URL=redis://127.0.0.1:16379
QUEUE_SIGNING_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
TICKET_QR_SIGNING_SECRET=replace-with-an-independent-32-character-secret

# Vercel/Upstash serverless checkout engine
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Vercel Marketplace may inject the equivalent aliases KV_REST_API_URL and
# KV_REST_API_TOKEN. The application accepts either pair; do not configure both.
CONCURRENT_CHECKOUT_CAPACITY=100
ADMISSION_TTL_SECONDS=120
HOLD_TTL_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=86400
CRON_SECRET=replace-with-at-least-16-random-characters

# Web / Supabase Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="WAR TICKET"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Worker
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Merchant provisioning command only (never expose these as NEXT_PUBLIC_*).
TENANT_ID=11111111-1111-4111-8111-111111111111
MIDTRANS_ENVIRONMENT=SANDBOX
MIDTRANS_MERCHANT_ID=replace-with-midtrans-merchant-id
MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
# Single-merchant key used by the serverless checkout slice; the legacy
# provisioning command encrypts the same key into PostgreSQL per tenant.
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_ENABLED=false
# ACTOR_USER_ID=optional-supabase-user-uuid

# Midtrans credentials are stored encrypted per tenant in
# ticketing.merchant_configs. Do not expose a server key through NEXT_PUBLIC_*.
